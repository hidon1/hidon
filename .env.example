# Server Configuration
PORT=10000

# CORS Configuration
# Comma-separated list of allowed origins for Socket.io CORS
# Example: https://hidon1.com,https://www.hidon1.com,http://localhost:3000
ALLOWED_ORIGINS=https://hidon1.com,https://www.hidon1.com,http://localhost:3000

# Environment
NODE_ENV=development

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# If using multiline key, escape newlines as \n
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n

# Google Apps Script Contact Form Configuration
# Note: The actual GAS Web App URL and token are configured in src/config/gas-config.js
# For production, replace the __GAS_TOKEN_PLACEHOLDER__ in gas-config.js with your actual token
# DO NOT commit the real token to public repositories
# GAS_TOKEN=your-actual-secret-token-here (configure this in production only)

